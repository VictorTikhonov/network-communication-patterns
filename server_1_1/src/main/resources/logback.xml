<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <appender name="SERVER_RESPONSE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger
                message = %msg
                remote = %X{remote}
                thread = %X{thread}%n%n</pattern>
        </encoder>
    </appender>

    <appender name="DEFAULT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger -- %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ============ HOT-PATH: WARN для замеров ============ -->

    <!-- Task 1: TCP blocking — лог каждого ответа в handleClient -->
    <logger name="ru.tikhonov.task_1.TcpServer" level="WARN"/>

    <!-- Task 3: gRPC — лог каждого onNext -->
    <logger name="ru.tikhonov.task_3.EchoServiceImpl" level="WARN"/>

    <!-- Старт/стоп серверов — оставляем INFO, их мало -->
    <logger name="ru.tikhonov.task_3.GrpcServer" level="INFO"/>

    <!-- Per-response TCP + Netty — лог каждого ответа -->
    <logger name="Benchmark.Server.Response" level="WARN" additivity="false">
        <appender-ref ref="SERVER_RESPONSE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="DEFAULT"/>
    </root>

</configuration>